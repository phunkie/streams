includes:
    - phpstan-baseline.neon
    - vendor/phunkie/phpstan/extension.neon

parameters:
    level: 3
    paths:
        - src
    excludePaths:
        - vendor
    ignoreErrors:
        -
            message: '#Anonymous function has an unused use#'
            paths:
                - src/Ops/Pull/*/CompileOps.php
